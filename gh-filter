#!/bin/bash
# gh-filter: shim for `gh` that enforces an owner allowlist on every invocation.
#
# Installed by the gh-filter brew formula at `$(brew --prefix gh-filter)/libexec/gh-filter`.
# The user activates the filter by prepending `$(brew --prefix gh-filter)/libexec/shim`
# to PATH, which makes `gh` resolve to a shim that execs this script. The real gh binary
# stays at `$(brew --prefix gh)/bin/gh` and is auto-resolved from the brew cellar at
# runtime (or via the `GH_FILTER_REAL_GH` env var).
#
# On allow: exec real gh with the original args.
# On block: print a verbose error to stderr, send a Pushover notification
#           via `notify` (if installed), and exit 77.
#
# The allowlist is configured by the operator — see README. Reads against
# third-party public repos remain available via `curl https://api.github.com/...`
# directly (the filter only mediates `gh`, not `curl`).

set -uo pipefail

# ---- Configuration ----------------------------------------------------------

# Allowlist comes from a config file at `~/.config/gh-filter/config` (XDG
# default; override with GH_FILTER_CONFIG). Format is `KEY=VALUE`:
#
#     ALLOWED_OWNERS=owner1,owner2,owner3
#
# Default is empty — with no config file in place, every repo-targeted `gh`
# invocation is blocked. This is intentional: an unconfigured filter should
# fail closed.
GH_FILTER_CONFIG="${GH_FILTER_CONFIG:-$HOME/.config/gh-filter/config}"

ALLOWED_OWNERS=()
if [ -f "$GH_FILTER_CONFIG" ]; then
  raw=$(/usr/bin/sed -n -E 's/^[[:space:]]*ALLOWED_OWNERS[[:space:]]*=[[:space:]]*(.*)$/\1/p' "$GH_FILTER_CONFIG" | /usr/bin/tail -1)
  if [ -n "$raw" ]; then
    # Strip optional surrounding quotes.
    raw="${raw#\"}"; raw="${raw%\"}"
    raw="${raw#\'}"; raw="${raw%\'}"
    IFS=',' read -ra parts <<< "$raw"
    for p in "${parts[@]}"; do
      # Trim leading/trailing whitespace.
      trimmed="${p#"${p%%[![:space:]]*}"}"
      trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
      [ -n "$trimmed" ] && ALLOWED_OWNERS+=("$trimmed")
    done
  fi
fi

# Optional agent-identity injection (see README §"Agent-identity injection").
# Two keys, both read from the same config file (env override in parens, which
# takes precedence and is handy for tests):
#
#   AGENT_TOKEN_COMMAND=/path/to/token-cmd   (GH_FILTER_AGENT_TOKEN_COMMAND)
#   AGENT_MARKER_ENVS=CLAUDECODE,OTHER_VAR   (GH_FILTER_AGENT_MARKER_ENVS)
#
# AGENT_TOKEN_COMMAND names a command whose stdout is a token to inject as
# GH_TOKEN for non-human ("agent") invocations. AGENT_MARKER_ENVS lists the env
# vars whose presence marks such an invocation. When AGENT_TOKEN_COMMAND is
# unset the entire identity stage is a no-op and the filter behaves as a pure
# owner-allowlist — the feature is strictly opt-in.
_read_cfg_scalar() {
  # _read_cfg_scalar KEY → prints the (last) configured value, quotes stripped.
  local key="$1" raw=""
  [ -f "$GH_FILTER_CONFIG" ] || { printf ''; return 0; }
  raw=$(/usr/bin/sed -n -E "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*(.*)$/\1/p" "$GH_FILTER_CONFIG" | /usr/bin/tail -1)
  raw="${raw#\"}"; raw="${raw%\"}"; raw="${raw#\'}"; raw="${raw%\'}"
  printf '%s' "$raw"
}

AGENT_TOKEN_COMMAND="${GH_FILTER_AGENT_TOKEN_COMMAND:-$(_read_cfg_scalar AGENT_TOKEN_COMMAND)}"

AGENT_MARKER_ENVS=()
_marker_raw="${GH_FILTER_AGENT_MARKER_ENVS:-$(_read_cfg_scalar AGENT_MARKER_ENVS)}"
if [ -n "$_marker_raw" ]; then
  IFS=',' read -ra _marker_parts <<< "$_marker_raw"
  for _m in "${_marker_parts[@]}"; do
    _m="${_m#"${_m%%[![:space:]]*}"}"
    _m="${_m%"${_m##*[![:space:]]}"}"
    [ -n "$_m" ] && AGENT_MARKER_ENVS+=("$_m")
  done
fi

# Resolve the `notify` binary for Pushover alerts. Default: PATH lookup.
# Override with GH_FILTER_NOTIFY if notify lives outside PATH.
NOTIFY="${GH_FILTER_NOTIFY:-$(command -v notify 2>/dev/null)}"

# Resolve the real gh binary. Prefer the env override, otherwise pick the
# highest version directory in /opt/homebrew/Cellar/gh.
REAL_GH="${GH_FILTER_REAL_GH:-}"
if [ -z "$REAL_GH" ] || [ ! -x "$REAL_GH" ]; then
  CANDIDATE_DIR=$(/bin/ls -1 /opt/homebrew/Cellar/gh 2>/dev/null | /usr/bin/sort -V | /usr/bin/tail -1)
  if [ -n "$CANDIDATE_DIR" ]; then
    REAL_GH="/opt/homebrew/Cellar/gh/${CANDIDATE_DIR}/bin/gh"
  fi
fi
if [ -z "$REAL_GH" ] || [ ! -x "$REAL_GH" ]; then
  /bin/echo "gh-filter: FATAL — real gh binary not found. Set GH_FILTER_REAL_GH or reinstall gh." >&2
  exit 70
fi

# ---- Helpers ----------------------------------------------------------------

ORIGINAL_ARGS=("$@")

emit_block_message() {
  local detected_target="$1"
  local reason="$2"
  local cmd_preview="gh"
  for a in "${ORIGINAL_ARGS[@]}"; do
    cmd_preview+=" $(printf '%q' "$a")"
  done

  /bin/cat >&2 <<EOF
================================================================
gh-filter: BLOCKED — target owner outside allowlist
================================================================
Attempted:       ${cmd_preview}
Detected target: ${detected_target:-<could not determine>}
Reason:          ${reason}
Allowed owners:  ${ALLOWED_OWNERS[*]:-<none configured>}
Config file:     ${GH_FILTER_CONFIG}

This shim wraps 'gh' to refuse any invocation that targets a repo outside
the configured allowlist. Reads against third-party public repos remain
fine via 'curl https://api.github.com/repos/<owner>/<name>/...' directly.

If you genuinely need this interaction, STOP and ask the operator first.
Wait for explicit, action-scoped approval before retrying.

DO NOT BYPASS. Calling the real gh by absolute path, raw curl with a bot
token, or 'git push' to a foreign remote are SEPARATE escalated violations.
Bypass attempts are also subject to phone notification.
================================================================
EOF
}

send_notification() {
  local detected_target="$1"
  local reason="$2"
  if [ -z "$NOTIFY" ] || [ ! -x "$NOTIFY" ]; then
    return
  fi
  local short_cmd="gh ${ORIGINAL_ARGS[*]}"
  if [ "${#short_cmd}" -gt 200 ]; then
    short_cmd="${short_cmd:0:200}..."
  fi
  "$NOTIFY" --message "gh-filter blocked: target=${detected_target:-unknown} reason=${reason} cmd=${short_cmd}" >/dev/null 2>&1 || true
}

deny() {
  local detected_target="$1"
  local reason="$2"
  emit_block_message "$detected_target" "$reason"
  send_notification "$detected_target" "$reason"
  exit 77
}

is_allowed_owner() {
  local owner="$1"
  # bash 3.2 + `set -u` treats `"${arr[@]}"` on an empty array as unbound;
  # guard explicitly so an unconfigured filter falls through to deny() with
  # a proper block message, not a crash.
  if [ "${#ALLOWED_OWNERS[@]}" -eq 0 ]; then
    return 1
  fi
  for allowed in "${ALLOWED_OWNERS[@]}"; do
    [ "$owner" = "$allowed" ] && return 0
  done
  return 1
}

# `gh project link|unlink` take `-T, --team [HOST/]OWNER/TEAM`, and per the gh
# source the team's OWNER sets the project owner when `--owner` is absent.
# Extract the owner: it is the component before the last in both the
# `OWNER/TEAM` and `HOST/OWNER/TEAM` forms.
team_owner() {
  local v="$1" rest
  rest="${v%/*}"          # strip /TEAM
  case "$rest" in
    */*) echo "${rest##*/}" ;;   # HOST/OWNER -> OWNER
    *)   echo "$rest" ;;         # OWNER
  esac
}

# Gate a target value that may be a COMMA-SEPARATED LIST.
#
# `gh search`'s --owner and --repo are `strings` flags, so `<a>,<b>` is one
# legal value. Two rules, and both are load-bearing:
#
#   - EVERY element must be allowed. One foreign element makes the whole call
#     foreign, because gh queries all of them.
#   - The DEFAULT IS DENY. The first version put `deny` inside the loop and
#     `exec` after it, so a value that checked NOTHING fell straight through to
#     the exec: `--org ,` measured ALLOW. A gate whose safe answer depends on
#     its loop body executing is not a gate.
#
#     Be precise about which guard catches that, because the obvious answer is
#     wrong on the deployment target. Measured on bash 3.2.57: `IFS=','
#     parts=(",")` yields ONE element (empty), not zero — so for `--org ,` the
#     zero-length-array branch never fires. What refuses it is the `seen`
#     counter: every element was empty, so none was checked, so nothing
#     licenses an allow. The array branch covers only a genuinely empty value.
#     Both are kept; neither alone is sufficient.
#
# Globbing is disabled for the split. Word-splitting an unquoted value with
# pathname expansion live let `--org '*'` expand against the CURRENT DIRECTORY,
# so a directory holding a file named after an allowlisted owner turned into an
# allow. Filesystem contents must not be an input to this decision.
#
# $1 = the raw value, $2 = "org" or "repo" (repo elements are OWNER/NAME).
# On refusal, echoes a COMPLETE reason phrase and returns 1 — complete rather
# than a fragment the caller re-wraps, because the malformed-input cases do not
# fit the "owner 'X' is not in the allowed list" sentence and reading
# `owner '<no owner in ...>'` back suggests a filter bug rather than bad input.
# Returns 0 only when at least one element was checked and all of them passed.
all_elements_allowed() {
  local raw="$1" kind="$2"
  local saved_ifs="$IFS" saved_glob=0 el owner seen=0
  # Both call sites are command substitutions, so this function already runs in
  # a subshell and the restores below cannot affect the caller. They are kept
  # anyway: the correctness of a gate should not rest on how its callers happen
  # to invoke it today.
  case "$-" in *f*) saved_glob=1 ;; esac
  set -f
  IFS=','
  # shellcheck disable=SC2206
  local parts=($raw)
  IFS="$saved_ifs"
  [ "$saved_glob" = "1" ] || set +f
  if [ "${#parts[@]}" -eq 0 ]; then
    echo "no target parsed from '$raw'"
    return 1
  fi
  for el in "${parts[@]}"; do
    [ -n "$el" ] || continue
    if [ "$kind" = "repo" ]; then
      owner="${el%%/*}"
    else
      owner="$el"
    fi
    if [ -z "$owner" ]; then
      # e.g. `--repo /` or `--repo /name`: there is a slash but no owner before
      # it. Reporting `owner ''` reads as a filter bug rather than as the
      # malformed input it is, so name the element instead.
      echo "'$el' names no owner before its slash"
      return 1
    fi
    if ! is_allowed_owner "$owner"; then
      if [ "$kind" = "repo" ]; then
        echo "owner '$owner' is not in the allowed list"
      else
        echo "org '$owner' is not in the allowed list"
      fi
      return 1
    fi
    seen=$((seen+1))
  done
  if [ "$seen" -eq 0 ]; then
    echo "no owner parsed from '$raw' (every element was empty)"
    return 1
  fi
  return 0
}

# ---- Agent-identity resolution ----------------------------------------------
# This stage decides WHICH identity a call runs as; the allowlist gate below
# decides WHETHER the call is permitted. Two separate jobs, two separate stages,
# and the allowlist stays the final gate — identity selection can never bypass
# blast-radius protection.

# True (0) when any configured marker env var is set and non-empty — i.e. this
# invocation is an agent/automation context, not an interactive human shell.
in_agent_context() {
  [ "${#AGENT_MARKER_ENVS[@]}" -eq 0 ] && return 1
  local name
  # Indirect expansion of an unset var trips `set -u`; relax it just here.
  set +u
  for name in "${AGENT_MARKER_ENVS[@]}"; do
    if [ -n "${!name}" ]; then
      set -u
      return 0
    fi
  done
  set -u
  return 1
}

# Run AGENT_TOKEN_COMMAND and export its stdout as GH_TOKEN. Fails CLOSED: if the
# command is missing, errors, or prints nothing, abort (exit 78) — never fall
# through to the ambient (human) credential, which is the leak this stage exists
# to prevent. The command must be a single executable that prints a token and
# must NOT itself invoke `gh` (that would recurse through this shim).
inject_agent_token() {
  local tok=""
  if [ ! -x "$AGENT_TOKEN_COMMAND" ] && ! command -v "$AGENT_TOKEN_COMMAND" >/dev/null 2>&1; then
    /bin/echo "gh-filter: FATAL — AGENT_TOKEN_COMMAND ('$AGENT_TOKEN_COMMAND') is not executable; refusing to fall back to the ambient credential." >&2
    exit 78
  fi
  # Mark the token command's environment so a nested `gh` (if the command
  # misbehaves and shells out to gh) is detected as re-entry, not run again.
  tok=$(GH_FILTER_RESOLVING_IDENTITY=1 "$AGENT_TOKEN_COMMAND" 2>/dev/null)
  if [ -z "$tok" ]; then
    /bin/echo "gh-filter: FATAL — AGENT_TOKEN_COMMAND produced no token; refusing to fall back to the ambient credential." >&2
    exit 78
  fi
  export GH_TOKEN="$tok"
}

# Identity precedence, evaluated only when AGENT_TOKEN_COMMAND is configured
# (otherwise a complete no-op — pure owner-allowlist behavior, unchanged):
#   1. caller already set GH_TOKEN/GITHUB_TOKEN → honor it, inject nothing
#   2. agent context (a marker env is set)      → inject AGENT_TOKEN_COMMAND
#   3. interactive human (stderr is a TTY)      → leave the ambient credential
#   4. neither (detached/cron/scrubbed env)     → fail closed to AGENT_TOKEN_COMMAND
resolve_identity() {
  [ -n "$AGENT_TOKEN_COMMAND" ] || return 0
  if [ -n "${GH_TOKEN:-}" ] || [ -n "${GITHUB_TOKEN:-}" ]; then
    return 0
  fi
  # Re-entry guard: past this point we may run AGENT_TOKEN_COMMAND. If we are
  # ALREADY inside one (it shelled out to gh without providing a token), that is
  # unbounded recursion — fail closed with a clear error instead of looping.
  if [ -n "${GH_FILTER_RESOLVING_IDENTITY:-}" ]; then
    /bin/echo "gh-filter: FATAL — AGENT_TOKEN_COMMAND invoked 'gh' without providing a token, which recurses through this shim. The token command must not call gh (use curl or a native API client)." >&2
    exit 78
  fi
  if in_agent_context; then
    inject_agent_token
  elif [ -t 2 ]; then
    return 0
  else
    inject_agent_token
  fi
}

# Resolve identity before any exec below, so every pass-through and allow path
# (auth status, api meta-paths, allowlisted repos) carries the resolved token.
resolve_identity

# ---- Subcommand pass-through gates ------------------------------------------

# No args: show gh's default help.
if [ $# -eq 0 ]; then
  exec "$REAL_GH"
fi

# Top-level meta flags.
case "${1:-}" in
  --version|-v|--help|-h)
    exec "$REAL_GH" "$@"
    ;;
esac

SUBCMD="${1:-}"

# Subcommands that don't touch a target repo. These read-only / local-state
# operations pass through unchecked.
case "$SUBCMD" in
  help|completion|config|status|alias|gpg-key|ssh-key|codespace|cache|attestation|variable|secret)
    # Note: variable/secret commands DO touch repos. We fall through to repo
    # detection below if they have --repo, by NOT exec-ing here.
    case "$SUBCMD" in
      help|completion|config|status|alias|gpg-key|ssh-key|cache)
        exec "$REAL_GH" "$@"
        ;;
    esac
    ;;
  auth)
    # All auth-state operations: login, logout, refresh, status, setup-git,
    # token, switch.
    exec "$REAL_GH" "$@"
    ;;
  extension)
    case "${2:-}" in
      install|upgrade|remove|create|browse)
        deny "extension:$2" "extension state changes are blocked; install manually if needed"
        ;;
      list|search|exec|"")
        exec "$REAL_GH" "$@"
        ;;
      *)
        exec "$REAL_GH" "$@"
        ;;
    esac
    ;;
esac

# Explicit block: `gh api graphql` can target any repo via the query body,
# which we can't reliably parse. Refuse it outright.
if [ "$SUBCMD" = "api" ]; then
  for a in "$@"; do
    if [ "$a" = "graphql" ]; then
      deny "<graphql>" "gh api graphql is blocked (query body can target any repo)"
    fi
  done
fi

# ---- Target repo detection --------------------------------------------------
#
# Two properties of everything below, stated once so nobody has to rediscover
# them: the scanners are POSITIONAL-NAIVE (they walk argv looking at each word
# in isolation — no `--` end-of-options handling, no notion of which words are
# a flag's VALUE rather than a flag), and step 4's git-remote read is a GUESS,
# not a determination. Steps 1-3 determine a target from argv; step 4 infers one
# from where the process happens to be standing, which is a different and much
# weaker claim. Anything that reaches step 4 with argv visibly naming a target
# is now refused rather than guessed at — see the guard above it.

TARGET_REPO=""

# 1. --repo OWNER/NAME, -R OWNER/NAME, --repo=OWNER/NAME, -R=OWNER/NAME
i=0
args=("$@")
while [ $i -lt ${#args[@]} ]; do
  a="${args[$i]}"
  # LAST occurrence wins, matching gh — see the note on the org loop below for
  # the `gh browse -R a/x -R b/y -n` receipt. Breaking on the first match gated
  # `-R <allowed>/x -R <foreign>/y` on the allowlisted one while gh targeted the
  # foreign one.
  case "$a" in
    --repo|-R)
      if [ $((i+1)) -lt ${#args[@]} ]; then
        TARGET_REPO="${args[$((i+1))]}"
      fi
      ;;
    --repo=*)
      TARGET_REPO="${a#--repo=}"
      ;;
    -R=*)
      TARGET_REPO="${a#-R=}"
      ;;
    # Attached shorthand: `gh issue list -Rowner/name`. gh accepts it; missing it
    # here left TARGET_REPO empty and the call fell through to the cwd-remote
    # fallback, i.e. gated on the WRONG owner.
    -R?*)
      TARGET_REPO="${a#-R}"
      ;;
  esac
  i=$((i+1))
done

# 1b. `--org OWNER` / `--org=OWNER`. Some subcommands (`gh secret set`,
# `gh variable set`, `gh ruleset`) target an ORG rather than a repo, so there is
# no OWNER/NAME to parse and detection below would fall through to a deny that
# reads as "could not determine target" — a false block on a perfectly legal
# call against an allowlisted owner. The owner is gated identically to the repo
# case; this widens the FORMS we can recognise, never the set of allowed owners.
TARGET_ORG=""
# `--org` only names the TARGET for subcommands that operate on an org. For
# `gh repo fork --org X` it names the fork DESTINATION while the write lands on
# the foreign upstream, so treating it as the target would let
# `repo fork <foreign>/x --org <allowed>` through. `gh repo read-file` uses -o
# for --output, which would swallow a filename as an org and false-block.
# Allowlist the subcommands where --org genuinely is the target.
# `project` belongs here too, and its absence was a hole rather than a nuance:
# ALL 19 `gh project` subcommands take `--owner`, it is the only owner-targeting
# `--owner` is NOT uniform across the tree, and the comment that used to claim
# it was cost a review round: 16 subcommands take `--owner`, `copy` takes
# `--source-owner`/`--target-owner` instead, `field-delete` and `item-edit`
# take no owner flag at all, and `link`/`unlink` additionally target via
# `--team [HOST/]OWNER/TEAM`. Every one of those is parsed below.
#
# 15 of the 19 are authenticated MUTATIONS: close,
# copy, create, delete, edit, field-create, field-delete, item-add,
# item-archive, item-create, item-delete, item-edit, link, mark-template,
# unlink. The other four — field-list, item-list, list, view — are reads. An
# enumeration invites checking, so it should be checkable: 15 + 4 = 19.
#
# With `project` absent, `--owner` went unparsed,
# detection found nothing, and the cwd-remote fallback gated the call on the
# local checkout's owner — so `project delete 1 --owner <foreign>` ran from any
# allowlisted checkout reached the real binary. There is no `-o` shorthand
# anywhere in the `project` tree, so the `--output` collision that keeps `repo`
# off this list does not apply.
# `search {repos,issues,code,commits,prs}` and `skill search` take `--owner`
# too. Receipt: `gh search repos --help` gives `--owner strings   Filter on
# owner`, and NONE of the six has an `-o` shorthand (checked each `--help`), so
# the `--output` collision that keeps `repo` off this list does not apply.
# Adding them is a net tightening — `search --owner <foreign>` was previously
# gated on the cwd — and it is also what stops the fail-closed guard below from
# false-blocking `search --owner <allowed>`, which is the routine pre-file
# duplicate scan.
case "$SUBCMD" in
  secret|variable|ruleset|codespace|attestation|project|search|skill) ORG_SUBCMD=1 ;;
  *) ORG_SUBCMD=0 ;;
esac
SELF_TARGET=0
EXTRA_OWNERS=""
if [ "$ORG_SUBCMD" = "1" ]; then
  i=0
  args=("$@")
  while [ $i -lt ${#args[@]} ]; do
    a="${args[$i]}"
    # LAST occurrence wins, matching gh. Cobra takes the final value of a
    # repeated flag — receipt, offline: `gh browse -R aaa-first/one
    # -R bbb-second/two -n` prints https://github.com/bbb-second/two. This loop
    # used to `break` on the FIRST match, so `--owner @me --owner <foreign>`
    # was gated on `@me` while gh targeted <foreign>. Record and keep walking.
    #
    # `@me` is documented and legal on every `gh project` subcommand
    # (`--owner string   Login of the owner. Use "@me" for the current user.`).
    # It names the AUTHENTICATED IDENTITY, not a third party, so it is neither
    # an org to look up nor a target to infer. Gating it would false-block;
    # falling through to the cwd-remote fallback would gate it on an unrelated
    # checkout's owner, which is the laundering this branch exists to stop.
    # Record it and allow explicitly — behind the empty-allowlist guard.
    case "$a" in
      --org|-o|--owner)
        if [ $((i+1)) -lt ${#args[@]} ]; then
          if [ "${args[$((i+1))]}" = "@me" ]; then
            SELF_TARGET=1; TARGET_ORG=""
          else
            TARGET_ORG="${args[$((i+1))]}"; SELF_TARGET=0
          fi
        fi
        ;;
      --org=*|--owner=*|-o=*)
        v="${a#*=}"
        if [ "$v" = "@me" ]; then SELF_TARGET=1; TARGET_ORG=""
        else TARGET_ORG="$v"; SELF_TARGET=0; fi
        ;;
      # `gh project copy` does not take `--owner` at all. It takes
      # `--source-owner` (what you read) and `--target-owner` (where the copy
      # lands) — receipt: `gh project copy --help`. Neither was parsed, so a
      # project copy INTO a foreign org was decided by the cwd remote. Both are
      # real targets, so both are accumulated and every one must be allowed;
      # they are appended rather than last-wins, because they name different
      # things and coexist in one invocation.
      # `--team`'s owner sets the project owner. Unparsed, all four spellings
      # reached the binary from an allowlisted checkout while the `--repo`
      # control on the same subcommand blocked — so it was the unparsed flag,
      # not the fallback.
      --team|-T)
        if [ $((i+1)) -lt ${#args[@]} ]; then
          v=$(team_owner "${args[$((i+1))]}")
          if [ "$v" = "@me" ]; then SELF_TARGET=1
          elif [ -n "$v" ]; then EXTRA_OWNERS="${EXTRA_OWNERS:+$EXTRA_OWNERS,}$v"; fi
        fi
        ;;
      --team=*|-T=*)
        v=$(team_owner "${a#*=}")
        if [ "$v" = "@me" ]; then SELF_TARGET=1
        elif [ -n "$v" ]; then EXTRA_OWNERS="${EXTRA_OWNERS:+$EXTRA_OWNERS,}$v"; fi
        ;;
      -T?*)
        v=$(team_owner "${a#-T}")
        if [ "$v" = "@me" ]; then SELF_TARGET=1
        elif [ -n "$v" ]; then EXTRA_OWNERS="${EXTRA_OWNERS:+$EXTRA_OWNERS,}$v"; fi
        ;;
      --source-owner|--target-owner)
        if [ $((i+1)) -lt ${#args[@]} ]; then
          v="${args[$((i+1))]}"
          if [ "$v" = "@me" ]; then SELF_TARGET=1
          else EXTRA_OWNERS="${EXTRA_OWNERS:+$EXTRA_OWNERS,}$v"; fi
        fi
        ;;
      --source-owner=*|--target-owner=*)
        v="${a#*=}"
        if [ "$v" = "@me" ]; then SELF_TARGET=1
        else EXTRA_OWNERS="${EXTRA_OWNERS:+$EXTRA_OWNERS,}$v"; fi
        ;;
      # Attached shorthand `-oORG`. gh accepts it and routes it to the org;
      # recognising only the space-separated form left TARGET_ORG empty, so the
      # cwd-remote fallback decided the verdict — from any allowlisted checkout
      # that passed a FOREIGN org's call straight through.
      -o?*)
        v="${a#-o}"
        if [ "$v" = "@me" ]; then SELF_TARGET=1; TARGET_ORG=""
        else TARGET_ORG="$v"; SELF_TARGET=0; fi
        ;;
    esac
    i=$((i+1))
  done
  # An explicit owner named by --source-owner/--target-owner outranks nothing
  # else here (project copy has no other owner flag), but if BOTH a plain
  # --owner and a copy owner somehow appear, every named owner still has to
  # pass — so join rather than choose.
  if [ -n "$EXTRA_OWNERS" ]; then
    TARGET_ORG="${TARGET_ORG:+$TARGET_ORG,}$EXTRA_OWNERS"
    SELF_TARGET=0
  fi
fi

# 2. `gh api`: extract /repos/OWNER/NAME from a path arg.
if [ -z "$TARGET_REPO" ] && [ "$SUBCMD" = "api" ]; then
  for a in "$@"; do
    if [[ "$a" =~ ^/?repos/([^/]+)/([^/?#]+) ]]; then
      TARGET_REPO="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
      break
    fi
  done
fi

# 3. `gh repo <verb> OWNER/NAME` positional form.
if [ -z "$TARGET_REPO" ] && [ "$SUBCMD" = "repo" ]; then
  for a in "${@:3}"; do
    case "$a" in
      -*) continue ;;
      */*)
        if [[ "$a" =~ ^([^/]+)/([^/]+)$ ]]; then
          TARGET_REPO="$a"
          break
        fi
        ;;
    esac
  done
fi

# 4. Fallback: current directory's git remote. Not consulted for `gh api`,
# because there the API path itself (or the absence of one) is the source of
# truth — meta-paths like `/user` should be evaluated against the api-block
# rules below, not the cwd's remote.
# An explicit --org beats an inferred remote: `gh secret set --org X` run from
# inside some unrelated checkout must be gated on X, not on that checkout's
# owner. Inferring the target from the cwd there is simply the wrong answer.
#
# Before inferring anything, refuse to infer at all when argv is visibly naming
# a target this parser did not consume. Five spellings have now been added in
# five separate patches (-R?*, -o=*, -o?*, --owner, project --owner) and EVERY
# miss failed OPEN: an unrecognised target flag leaves TARGET_REPO/TARGET_ORG
# empty, and the fallback below treats "I parsed nothing" as licence to guess
# from the current directory. For a shim whose contract is *fail closed when it
# cannot determine the target*, that is the contract inverted. Enumerating
# spellings can only ever be complete as of the `gh` version last read; this
# guard closes the class instead of the next instance.
#
# Deliberate limits, so the next reader does not overestimate it: it only
# recognises flags whose SHAPE is already known, so a future target flag spelled
# some other way still slips past; and the scanners here are positional-naive —
# no notion of a flag's value, so a literal `--org` appearing as some other
# flag's argument trips it. That direction fails closed and is recoverable.
if [ -z "$TARGET_REPO" ] && [ -z "$TARGET_ORG" ] && [ "$SELF_TARGET" != "1" ]; then
  for a in "$@"; do
    case "$a" in
      --) break ;;
      # `--org`/`--owner`/`--repo`/`-R` name a target wherever they appear, so
      # they are guarded unconditionally. `-o` is NOT unambiguous: on
      # `repo read-file` it is `--output`, and guarding it everywhere
      # false-blocked `repo read-file -o out.txt` — the canonical use of that
      # command, and the very collision cited as the reason `repo` stays out of
      # ORG_SUBCMD. Guard `-o` only where it means an org.
      -o|-o=*|-o?*)
        if [ "$ORG_SUBCMD" = "1" ]; then
          deny "<unparsed target flag: $a>" "argv names a target via '$a' that this filter did not parse; refusing to infer the target from the current directory"
        fi
        ;;
      --org|--org=*|--owner|--owner=*|--source-owner|--source-owner=*|--target-owner|--target-owner=*|--team|--team=*|-T|-T=*|-T?*|-R|-R=*|-R?*|--repo|--repo=*)
        deny "<unparsed target flag: $a>" "argv names a target via '$a' that this filter did not parse; refusing to infer the target from the current directory"
        ;;
    esac
  done
fi

if [ -z "$TARGET_REPO" ] && [ -z "$TARGET_ORG" ] && [ "$SELF_TARGET" != "1" ] \
   && [ "$SUBCMD" != "api" ]; then
  REMOTE_URL=$(git config --get remote.origin.url 2>/dev/null || true)
  if [ -n "$REMOTE_URL" ]; then
    # Strip trailing /  and .git, then extract OWNER/NAME from the URL tail.
    # Handles: git@github.com:OWNER/NAME(.git), https://github.com/OWNER/NAME(.git),
    # https://x-access-token:TOKEN@github.com/OWNER/NAME(.git),
    # ssh://git@github.com/OWNER/NAME(.git)
    clean_url="${REMOTE_URL%/}"
    clean_url="${clean_url%.git}"
    if [[ "$clean_url" =~ github\.com[:/]([^/]+)/([^/]+)$ ]]; then
      TARGET_REPO="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
    fi
  fi
fi

# ---- Allowlist gate ---------------------------------------------------------

# `--repo` and `--org` are NOT mutually exclusive for `secret`/`variable`: gh
# ignores --repo and hits the org endpoint. Gating on the repo first therefore
# checked an owner the call never touches, letting
# `-R <allowed>/x -o <foreign>` through. Whenever both are present, the ORG is
# the real target, so it wins.
if [ "$ORG_SUBCMD" = "1" ] && [ -n "$TARGET_ORG" ] && [ -n "$TARGET_REPO" ]; then
  TARGET_REPO=""
fi

if [ -n "$TARGET_REPO" ]; then
  if [ "${#ALLOWED_OWNERS[@]}" -eq 0 ]; then
    deny "$TARGET_REPO" "no allowlist configured; create $GH_FILTER_CONFIG with ALLOWED_OWNERS=owner1,owner2,..."
  fi
  # --repo is a `strings` flag on the same `gh search` commands as --owner, so
  # it takes a list too. Comparing the raw string let
  # `search code --repo <allowed>/x,<foreign>/y` through while the same call
  # without the comma blocked.
  if DENY_REASON=$(all_elements_allowed "$TARGET_REPO" repo); then
    exec "$REAL_GH" "$@"
  fi
  deny "$TARGET_REPO" "$DENY_REASON"
fi

# Org-targeted call (no repo). Same allowlist, same deny path.
#
# `gh search`'s --owner is a `strings` flag ("--owner strings   Filter on
# owner"), so a legal value can be a comma-separated LIST. Comparing the raw
# string would false-block `search repos --owner <allowed1>,<allowed2>` and,
# worse, would let nobody notice that `<allowed>,<foreign>` names a foreign org
# too. Split and require EVERY element to be allowed.
if [ -n "$TARGET_ORG" ]; then
  if [ "${#ALLOWED_OWNERS[@]}" -eq 0 ]; then
    deny "$TARGET_ORG" "no allowlist configured; create $GH_FILTER_CONFIG with ALLOWED_OWNERS=owner1,owner2,..."
  fi
  if DENY_REASON=$(all_elements_allowed "$TARGET_ORG" org); then
    exec "$REAL_GH" "$@"
  fi
  deny "$TARGET_ORG" "$DENY_REASON"
fi

# `--owner @me`: the target is the authenticated identity itself. Nothing to
# look up against the allowlist, and nothing to infer — allow it explicitly
# rather than letting it fall through to the cwd-remote guess.
if [ "$SELF_TARGET" = "1" ]; then
  # "No allowlist configured" means THIS SHIM IS NOT SET UP, and the correct
  # answer to every call in that state is no — including one whose target is
  # the caller itself. Skipping this check made a fresh install, before its
  # config is written, exec `project delete N --owner @me` (no confirmation
  # flag) unguarded. Measured regression: `secret list --org @me` with no
  # config went 77 -> 0 when the self-target path was introduced.
  if [ "${#ALLOWED_OWNERS[@]}" -eq 0 ]; then
    deny "@me" "no allowlist configured; create $GH_FILTER_CONFIG with ALLOWED_OWNERS=owner1,owner2,..."
  fi
  exec "$REAL_GH" "$@"
fi

# No target detected. If this is a `gh api` call to a non-repo path, allow it
# when it matches either a GitHub-wide meta path or an `/orgs/<allowed-owner>`
# path for a configured allowlist owner.
if [ "$SUBCMD" = "api" ]; then
  for a in "$@"; do
    # `gh api` accepts a meta/orgs path with OR without a leading slash
    # (e.g. `orgs/OWNER/repos` == `/orgs/OWNER/repos`, `licenses/mit` ==
    # `/licenses/mit`). Normalise to the leading-slash form for matching by
    # prepending a slash to non-flag args that lack one — mirroring the `^/?`
    # already used for `repos/` paths. (repos/ paths never reach here; they're
    # resolved earlier via TARGET_REPO. The owner allowlist below is unchanged,
    # so this loosens the path FORM, never the owner check.)
    case "$a" in
      -*|/*) ap="$a" ;;
      *)     ap="/$a" ;;
    esac
    case "$ap" in
      /user|/users/*|/search/*|/rate_limit|/meta|/octocat|/zen|/emojis|/licenses|/licenses/*|/gitignore|/gitignore/*|/app|/app/*|/installation|/installation/*|/markdown|/markdown/*|/feeds|/notifications|/notifications/*)
        exec "$REAL_GH" "$@"
        ;;
    esac
    if [ "${#ALLOWED_OWNERS[@]}" -gt 0 ]; then
      for owner in "${ALLOWED_OWNERS[@]}"; do
        if [ "$ap" = "/orgs/$owner" ] || [[ "$ap" == /orgs/"$owner"/* ]]; then
          exec "$REAL_GH" "$@"
        fi
      done
    fi
  done
  # `gh api` against an unrecognized path with no /repos/ prefix → refuse.
  deny "" "gh api path did not match any allowed pattern; pass /repos/<allowed-owner>/<name>/... or a meta path (/user, /orgs/<allowed>/... — leading slash optional)"
fi

# Couldn't determine target, not a pass-through subcommand → refuse, suggest --repo.
deny "" "could not determine target repo from arguments or current git remote; pass --repo OWNER/NAME explicitly"
